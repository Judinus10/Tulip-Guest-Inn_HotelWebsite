APP_ENV=production
APP_TIMEZONE=Asia/Colombo

FRONTEND_URL=https://www.example.com
PUBLIC_APP_URL=https://www.example.com
ADMIN_APP_URL=https://admin.example.com
API_BASE_URL=https://www.example.com/api
ASSET_BASE_URL=https://www.example.com/api
ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com

DB_HOST=localhost
DB_NAME=tulip_guest_inn
DB_USER=tulip_app
DB_PASS=replace-with-a-strong-password
DB_CHARSET=utf8mb4

PAYHERE_MERCHANT_ID=replace-me
PAYHERE_MERCHANT_SECRET=replace-me
PUBLIC_TOKEN_SECRET=generate-a-separate-random-64-character-secret
BOOKING_LINK_TTL_SECONDS=86400
INVOICE_LINK_TTL_SECONDS=604800
# Temporary migration deadline in UTC. Leave blank to reject old non-expiring links.
ALLOW_LEGACY_PUBLIC_TOKENS_UNTIL=

ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=30
PUBLIC_RATE_LIMIT_MAX=8
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_PIXELS=24000000

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=tls
ADMIN_EMAIL=
BOOKING_ADMIN_EMAIL=
CONTACT_ADMIN_EMAIL=
FROM_EMAIL=
FROM_NAME=Tulip Guest Inn

EMAIL_QUEUE_CRON_TOKEN=generate-a-long-random-secret
STAY_REMINDER_CRON_TOKEN=generate-a-different-long-random-secret
