# Tulip Guest Inn - Local Development (example; replace placeholder secrets)
APP_ENV=local
APP_TIMEZONE=Asia/Colombo
APP_BASE_URL=http://localhost:5173/
FRONTEND_URL=http://localhost:5173/
PUBLIC_APP_URL=http://localhost:5173/
ADMIN_APP_URL=http://localhost:5174/
API_BASE_URL=http://localhost/project_Tulip/api
ASSET_BASE_URL=http://localhost/project_Tulip/api
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

DB_HOST=localhost
DB_NAME=hotel_tulip
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

MAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
TULIP_PAYMENT_ENCRYPTION_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

ICS_SYNC_ENABLED=true
ICS_TEST_MODE=false
ICS_DEFAULT_TIMEZONE=Asia/Colombo
ICS_REQUEST_TIMEOUT_SECONDS=15
ICS_MAX_RESPONSE_BYTES=1048576
ICS_ROOM_MAPPINGS_JSON='[]'

ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=30
PUBLIC_RATE_LIMIT_MAX=8
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15
PUBLIC_TOKEN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
BOOKING_LINK_TTL_SECONDS=86400
INVOICE_LINK_TTL_SECONDS=604800
ALLOW_LEGACY_PUBLIC_TOKENS_UNTIL=
EMAIL_QUEUE_CRON_TOKEN=REPLACE_WITH_STRONG_RANDOM_SECRET
STAY_REMINDER_CRON_TOKEN=REPLACE_WITH_STRONG_RANDOM_SECRET

TEST_EMAIL_DEBUG=false
TEST_EMAIL_TOOL_ENABLED=false

# Applies to request JSON and secure_image_upload; video upload limits are separate.
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_PIXELS=24000000

# Room prices are stored only in the database (rooms.base_price).
